RewriteEngine On
RewriteBase /Live-Cut-Editor/test-real/

# Remove .php extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Prevent directory listing
Options -Indexes

# Error handling
ErrorDocument 404 /Live-Cut-Editor/test-real/editor.php
